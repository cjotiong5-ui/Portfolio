{
  "$schema": "https://opencode.ai/config.json",
  "share": "disabled",
  "skills": {
    "paths": [".opencode/skills"]
  },
  "permission": {
    "bash": {
      "*": "ask",
      "npm run dev": "allow",
      "npm run build": "allow",
      "npm run preview": "allow",
      "npm ci": "allow",
      "npm install": "allow",
      "npm ls *": "allow",
      "git status": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git add*": "allow",
      "git push*": "ask",
      "rm -rf *": "deny",
      "rm -fr *": "deny",
      "Remove-Item -Recurse *": "deny",
      "git commit*": "ask",
      "git reset --hard*": "deny",
      "git push --force*": "deny"
    }
  }
}